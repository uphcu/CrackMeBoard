# CrackMeBoard Gunicorn systemd service
[Unit]
Description=CrackMeBoard Gunicorn daemon
After=network.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/crackmeboard
Environment="PATH=/opt/crackmeboard/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/crackmeboard/venv/bin/gunicorn \
    -w 2 \
    -b 127.0.0.1:8000 \
    --access-logfile /var/log/crackmeboard/access.log \
    --error-logfile /var/log/crackmeboard/error.log \
    --access-logformat '%(h)s %(l)s %(u)s %(t)s "%(r)s" %(s)s %(b)s "%(f)s" "%(a)s"' \
    app:create_app()
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target